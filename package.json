{
  "name": "gridiron-overdrive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GRIDIRON OVERDRIVE — an original 7-on-7 arcade football game for the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "sim:batch": "tsx tools/sim.ts --games 200",
    "scenarios": "tsx tools/scenarios.ts",
    "invariants": "tsx tools/sim.ts --games 50 --invariants",
    "smoke": "tsx tools/smoke.ts",
    "capture": "tsx tools/capture.ts",
    "perf": "tsx tools/perf.ts",
    "qa": "npm run typecheck && npm test && npm run scenarios && npm run replay && npm run human && npm run sim:batch && npm run fieldpos && npm run smoothness && npm run artifact && npm run artifact:check",
    "replay": "tsx tools/determinism.ts",
    "perf:sim": "tsx tools/simperf.ts",
    "smoothness": "tsx tools/smoothness.ts",
    "pacing": "tsx tools/framepacing.ts",
    "shot": "tsx tools/shot.ts",
    "artifact": "tsx tools/artifact.ts",
    "artifact:check": "tsx tools/artifactcheck.ts",
    "human": "tsx tools/humanprobe.ts",
    "touch": "tsx tools/touchprobe.ts",
    "gait": "tsx tools/gait.ts",
    "poses": "tsx tools/poses.ts",
    "footslip": "tsx tools/footslip.ts",
    "fieldpos": "tsx tools/fieldpos.ts",
    "acceptance": "tsx tools/acceptance.ts",
    "passprobe": "tsx tools/passprobe.ts",
    "driveprobe": "tsx tools/driveprobe.ts",
    "runprobe": "tsx tools/runprobe.ts",
    "deepprobe": "tsx tools/deepprobe.ts",
    "anthro": "tsx tools/anthro.ts",
    "roster": "tsx tools/roster.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.169.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
