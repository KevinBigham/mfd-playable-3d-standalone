{
  "name": "@mfd/pascal-stadium-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated Pascal semantic authoring plugin for MFD stadium visual assets",
  "license": "MIT",
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "bootstrap:prereqs": "node ./scripts/install-bun.mjs",
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "studio": "node ./scripts/bootstrap.mjs --run",
    "dev": "node ./scripts/bootstrap.mjs --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "export:showcase": "tsx ./scripts/export-showcase.ts",
    "build": "tsc --noEmit -p tsconfig.build.json && node ./scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@pascal-app/core": "0.9.2",
    "@pascal-app/editor": "0.9.2",
    "@pascal-app/viewer": "0.9.2",
    "@react-three/fiber": "9.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.185.1",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@pascal-app/core": "0.9.2",
    "@pascal-app/editor": "0.9.2",
    "@pascal-app/viewer": "0.9.2",
    "@react-three/fiber": "9.5.0",
    "@types/node": "22.19.20",
    "@types/howler": "2.2.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.184.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "tsx": "4.20.3",
    "vitest": "2.1.9",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  }
}
